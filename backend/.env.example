# =============================================================================
# GRC Auditor — Backend (FastAPI) environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# =============================================================================

# --- Server ---
HOST=127.0.0.1
PORT=8001
# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# --- Databases (SQLite by default; Postgres supported via DATABASE_URL) ---
# Canonical ORM database (users, integrations, controls, risks, ...).
DATABASE_URL=sqlite:///./grc_enterprise.db
# RAG corpus lives in its OWN file so it never collides with the ORM DB.
RAG_DB_PATH=grc_rag_corpus.db

# --- Identity / Auth (Clerk) ---
# JWKS endpoint used to verify Clerk-issued JWTs (RS256).
CLERK_JWKS_URL=
# Optional: restrict the accepted audience. Leave blank to skip aud verification.
CLERK_AUDIENCE=
# Secret key for server-side Clerk Admin API (user sync). Keep secret.
CLERK_SECRET_KEY=
# Local-only auth bypass for offline development. MUST be false in any shared env.
CLERK_MOCK_AUTH=false

# --- Super admin allowlist (grant by immutable Clerk id, or VERIFIED email) ---
SUPER_ADMIN_USER_IDS=
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_ACCESS_KEY=change-me

# --- Credential vault (envelope encryption for stored provider API keys) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_SECRET_KEY=

# --- AI providers ---
# The platform targets a single in-house trained GRC model ("inhouse"). Groq is
# the interim provider for testing until that model is ready; remove it once the
# in-house model is serving. No other LLM vendors are supported.

# Groq (interim, for testing).
GROQ_API_KEY=

# In-house trained GRC model. Serve it behind any OpenAI-compatible endpoint
# (e.g. vLLM / TGI), then set the base URL + model in Settings -> AI Gateway, or
# here. INHOUSE_API_KEY is optional for self-hosted endpoints that need no key.
INHOUSE_API_KEY=
# (Base URL and model id are configured per-org in Settings; defaults to model
#  id "grc-auditor-v1".)

# Optional: embedding backend for semantic RAG. This is separate from the chat
# provider — neither Groq nor the in-house chat model serves embeddings. Leave
# blank to use lexical search. Supported embedding keys: OPENAI_API_KEY or
# GEMINI_API_KEY (used ONLY for vectors, never for chat).
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=

# --- Connector credentials (optional; only needed to run live audits) ---
# Most connectors take their credentials at runtime via the Integrations UI
# (encrypted in the BYOK vault). The env vars below are only fallbacks for
# local dev / headless use. Exact variable names per connector live in
# integration_clients.py.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GITHUB_TOKEN=
OKTA_ORG_URL=
OKTA_API_TOKEN=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- OAuth apps (developer-registered; enable the "OAuth Web Connection" tab) ---
# Register an OAuth app with the vendor, set the callback/redirect URL to
#   {PUBLIC_API_BASE_URL}/api/integrations/<connector_id>/callback
# then fill the client id/secret. A connector only shows the OAuth tab once BOTH
# are present. Providers are declared in main.py OAUTH_PROVIDERS — add an entry
# there to enable a new one. Public base URL used to build the redirect:
PUBLIC_API_BASE_URL=http://localhost:8001

# GitHub OAuth app (callback: {PUBLIC_API_BASE_URL}/api/integrations/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google Workspace OAuth (uncomment the OAUTH_PROVIDERS entry in main.py too):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
