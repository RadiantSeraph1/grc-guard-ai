# Local databases, uploads, and generated runtime data
*.db
backend/*.db
# SQLite WAL/SHM sidecar files (created by WAL journal mode)
*.db-wal
*.db-shm
*.db-journal
backend/uploads/
backend/temp_uploads/
uploads/
temp_uploads/

# Local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# Logs and local run output
*.log
*_stdout.txt
*_stderr.txt
clerk_stdout.txt
clerk_stderr.txt
backend_stdout.txt
backend_stderr.txt
frontend_stdout.txt
frontend_stderr.txt

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# k8s Secret manifest — contains real credentials once filled in, never commit.
# Apply directly to the cluster with `kubectl apply -f k8s/secrets.yaml` instead.
k8s/secrets.yaml
k8s/fineract/secret.yaml
k8s/wazuh/secret.yaml
