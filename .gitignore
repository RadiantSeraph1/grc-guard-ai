# Secrets and local environment
.env
.env.*
!.env.example
!.env*.example
backend/.env
frontend/.env.local

# Dependencies
node_modules/
frontend/node_modules/
backend/venv/
venv/
.venv/

# Build outputs and caches
.next/
frontend/.next/
dist/
build/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
